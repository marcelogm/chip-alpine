CONFIG_FIT=y
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run chip_boot"
CONFIG_SYS_BOOTM_LEN=0x2000000
CONFIG_ENV_SOURCE_FILE="chip-alpine"
CONFIG_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_NAND_SUNXI=y
# CONFIG_CMD_NAND is not set
CONFIG_SYS_NAND_BLOCK_SIZE=0x400000
CONFIG_SYS_NAND_PAGE_SIZE=0x4000
CONFIG_SYS_NAND_OOBSIZE=0x500
CONFIG_NAND_SUNXI_SPL_USABLE_PAGE_SIZE=4096
CONFIG_SYS_NAND_U_BOOT_OFFS=0xc00000
CONFIG_SYS_NAND_U_BOOT_OFFS_REDUND=0x2c00000
CONFIG_SPL_LEGACY_IMAGE_CRC_CHECK=y
# CONFIG_CHIP_DIP_SCAN is not set
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_BOOTSTD is not set
# CONFIG_CMD_DFU is not set
CONFIG_NO_NET=y
# CONFIG_USB is not set
# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
CONFIG_NAND_SUNXI_SPL_SLC_MODE=y

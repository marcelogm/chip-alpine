CONFIG_FIT=y
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run chip_boot"
CONFIG_SYS_BOOTM_LEN=0x2000000
CONFIG_ENV_SOURCE_FILE="chip-alpine"
CONFIG_MTD=y
CONFIG_MTD_RAW_NAND=y
CONFIG_NAND_SUNXI=y
CONFIG_SYS_NAND_ONFI_DETECTION=y
CONFIG_SYS_NAND_BLOCK_SIZE=0x400000
CONFIG_SYS_NAND_PAGE_SIZE=0x4000
CONFIG_SYS_NAND_OOBSIZE=0x500
CONFIG_SYS_NAND_MAX_ECCPOS=1664
CONFIG_NAND_SUNXI_SPL_USABLE_PAGE_SIZE=4096
CONFIG_CMD_NAND=y
CONFIG_USB_FUNCTION_ACM=y

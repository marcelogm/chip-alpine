CONFIG_CMD_MTDPARTS=y
CONFIG_DM_MTD=y
CONFIG_MTDIDS_DEFAULT="nand0=nand0"
CONFIG_MTDPARTS_DEFAULT="nand0:0x400000(spl),0x400000(spl-backup),0x400000(uboot),-(UBI)slc"
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD=y
CONFIG_SYS_NAND_BLOCK_SIZE=0x400000
CONFIG_SYS_NAND_OOBSIZE=0x500
CONFIG_SYS_NAND_PAGE_SIZE=0x4000
CONFIG_NAND_SUNXI_SPL_USABLE_PAGE_SIZE=4096
CONFIG_CMD_UBI=y
CONFIG_UBI_SILENCE_MSG=y
CONFIG_BOOTCOMMAND="setenv chip_bootargs console=ttyS0,115200 panic=10; run bootcmd_fel; ubi part UBI; ubi read 0x42000000 boot-a && setenv bootargs ${chip_bootargs} chip.slot=a && bootm 0x42000000; ubi read 0x42000000 boot-b && setenv bootargs ${chip_bootargs} chip.slot=b && bootm 0x42000000"

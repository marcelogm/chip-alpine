--- a/drivers/mtd/nand/raw/sunxi_nand_spl.c
+++ b/drivers/mtd/nand/raw/sunxi_nand_spl.c
@@ -600,10 +600,27 @@
 	return -EINVAL;
 }
 
-static int nand_read_buffer(struct nfc_config *conf, uint32_t offs,
+static uint32_t nand_physical_offset(struct nfc_config *conf, uint32_t base,
+				     uint32_t done)
+{
+	uint32_t half_block = CONFIG_SYS_NAND_BLOCK_SIZE / 2;
+	uint32_t pair, page;
+
+	if (!IS_ENABLED(CONFIG_NAND_SUNXI_SPL_SLC_MODE))
+		return base + done;
+
+	pair = (done % half_block) / conf->page_size;
+	page = pair ? 2 * pair - 1 : 0;
+
+	return base + (done / half_block) * CONFIG_SYS_NAND_BLOCK_SIZE +
+	       page * conf->page_size;
+}
+
+static int nand_read_buffer(struct nfc_config *conf, uint32_t base,
 			    unsigned int size, void *dest)
 {
 	int first_seed = 0, page, ret;
+	uint32_t done = 0, offs = base;
 
 	size = ALIGN(size, conf->page_size);
 	page = offs / conf->page_size;
@@ -611,6 +628,9 @@
 		first_seed = page % conf->nseeds;
 
 	for (; size; size -= conf->page_size) {
+		offs = nand_physical_offset(conf, base, done);
+		page = offs / conf->page_size;
+
 		if (nand_load_page(conf, offs))

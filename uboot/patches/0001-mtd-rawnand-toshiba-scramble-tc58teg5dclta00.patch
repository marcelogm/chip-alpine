--- a/drivers/mtd/nand/raw/nand_toshiba.c
+++ b/drivers/mtd/nand/raw/nand_toshiba.c
@@ -18,6 +18,7 @@
 
 #include <linux/bug.h>
 #include <linux/mtd/rawnand.h>
+#include <linux/string.h>
 
 static void toshiba_nand_decode_id(struct nand_chip *chip)
 {
@@ -65,11 +66,26 @@
 	}
 }
 
+static bool toshiba_nand_is_tc58teg5dclta00(struct nand_chip *chip)
+{
+	const char *model = "";
+
+	if (chip->onfi_version)
+		model = chip->onfi_params.model;
+	else if (chip->jedec_version)
+		model = chip->jedec_params.model;
+
+	return !strncmp(model, "TC58TEG5DCLTA00", 15);
+}
+
 static int toshiba_nand_init(struct nand_chip *chip)
 {
 	if (nand_is_slc(chip))
 		chip->bbt_options |= NAND_BBT_SCAN2NDPAGE;
 
+	if (toshiba_nand_is_tc58teg5dclta00(chip))
+		chip->options |= NAND_NEED_SCRAMBLING;
+
 	return 0;
 }
 

 #if CONFIG_SYS_NAND_U_BOOT_OFFS != CONFIG_SYS_NAND_U_BOOT_OFFS_REDUND
-	if (err)
+	if (err || !spl_nand_image_intact(spl_image))
 		err = spl_nand_load_element(spl_image, bootdev,

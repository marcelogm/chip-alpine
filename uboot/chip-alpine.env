chip_bootargs=console=ttyS0,115200 panic=10
chip_boot=if test -n "${fel_scriptaddr}"; then source ${fel_scriptaddr}; else run chip_boot_nand; fi; reset
chip_boot_nand=if itest.s *0x49ffffe0 == boot-b; then setenv chip_slot b; else setenv chip_slot a; fi; setenv bootargs "${chip_bootargs} chip.slot=${chip_slot}"; bootm 0x4a100000

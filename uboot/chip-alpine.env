chip_bootargs=console=ttyS0,115200 panic=10
chip_load=0x42000000
chip_boot=if test -n "${fel_scriptaddr}"; then source ${fel_scriptaddr}; fi; run chip_boot_a; run chip_boot_b; run chip_rescue
chip_boot_a=nand read ${chip_load} 0xc00000 0x2000000 && setenv bootargs "${chip_bootargs} chip.slot=a" && bootm ${chip_load}
chip_boot_b=nand read ${chip_load} 0x2c00000 0x2000000 && setenv bootargs "${chip_bootargs} chip.slot=b" && bootm ${chip_load}
chip_rescue=setenv stdin serial,usbacm; setenv stdout serial,usbacm; setenv stderr serial,usbacm; echo chip-alpine: no slot booted

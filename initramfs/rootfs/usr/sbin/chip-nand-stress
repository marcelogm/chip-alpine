#!/bin/sh
set -eu

mnt=/mnt/stress
chunk=/tmp/chunk

ubi_mtd() {
	awk -F: '/"UBI"/ { print $1 }' /proc/mtd
}

ecc_stats() {
	d=/sys/class/mtd/$(ubi_mtd)
	echo "corrected=$(cat "$d/corrected_bits") failed=$(cat "$d/ecc_failures") bad=$(cat "$d/bad_blocks")"
}

attach() {
	[ -e /dev/ubi0 ] || ubiattach -p "/dev/$(ubi_mtd)"
}

mount_volume() {
	attach
	mkdir -p "$mnt"
	mountpoint -q "$mnt" || mount -t ubifs ubi0:stress "$mnt"
}

format() {
	umount "$mnt" 2>/dev/null || true
	[ ! -e /dev/ubi0 ] || ubidetach -p "/dev/$(ubi_mtd)"
	ubiformat -y "/dev/$(ubi_mtd)"
	attach
	ubimkvol /dev/ubi0 -N stress -m
	mount_volume
	ecc_stats
}

verify() {
	dir=$1
	complete=$(mktemp)
	grep -E '^[0-9a-f]{64}  f[0-9]{6}$' "$dir/manifest" > "$complete" 2>/dev/null || true
	count=$(grep -c . "$complete" || true)
	rc=0
	if [ "$count" -gt 0 ]; then
		(cd "$dir" && sha256sum -c "$complete") > "$complete.out" 2>&1 || rc=$?
		grep -v ': OK$' "$complete.out" || true
	fi
	rm -f "$complete" "$complete.out"
	if [ "$rc" -ne 0 ]; then
		echo "verification FAILED"
		return "$rc"
	fi
	echo "verified $count files"
}

cycles() {
	total=$1
	mount_volume
	i=1
	while [ "$i" -le "$total" ]; do
		head -c 52428800 /dev/urandom > "$chunk"
		want=$(sha256sum < "$chunk" | cut -d' ' -f1)
		cp "$chunk" "$mnt/cycle"
		sync
		echo 3 > /proc/sys/vm/drop_caches
		got=$(sha256sum < "$mnt/cycle" | cut -d' ' -f1)
		rm "$mnt/cycle"
		sync
		if [ "$got" != "$want" ]; then
			echo "cycle $i FAIL $(ecc_stats)"
			return 1
		fi
		echo "cycle $i ok $(ecc_stats)"
		i=$((i + 1))
	done
	echo "done $total cycles $(ecc_stats)"
}

powercut_write() {
	mount_volume
	rm -f "$mnt"/f* "$mnt/manifest"
	sync
	i=0
	while :; do
		i=$((i + 1))
		name=$(printf 'f%06d' "$i")
		head -c 4194304 /dev/urandom > "$chunk"
		cp "$chunk" "$mnt/$name"
		sync
		echo "$(sha256sum < "$chunk" | cut -d' ' -f1)  $name" >> "$mnt/manifest"
		sync
	done
}

case "${1:-}" in
	format) format ;;
	mount) mount_volume ;;
	cycles) cycles "$2" ;;
	powercut-write) powercut_write ;;
	powercut-check) mount_volume; verify "$mnt"; ecc_stats ;;
	verify) verify "$2" ;;
	stats) ecc_stats ;;
	*)
		echo "usage: chip-nand-stress format|mount|cycles N|powercut-write|powercut-check|verify DIR|stats" >&2
		exit 2
		;;
esac

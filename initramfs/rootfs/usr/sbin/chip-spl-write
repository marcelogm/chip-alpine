#!/bin/sh
set -eu

PAGE_WITH_OOB=$((16384 + 1280))

usage() {
	echo "usage: chip-spl-write IMAGE" >&2
	exit 2
}

[ $# -eq 1 ] || usage
image=$1

size=$(stat -c %s "$image")
if [ "$size" -eq 0 ] || [ $((size % PAGE_WITH_OOB)) -ne 0 ]; then
	echo "$image is not whole pages of $PAGE_WITH_OOB bytes with their oob" >&2
	exit 2
fi
pages=$((size / PAGE_WITH_OOB))

for label in spl spl-backup; do
	mtd=/dev/$(grep "\"$label\"" /proc/mtd | cut -d: -f1)
	flash_erase -q "$mtd" 0 0
	nandwrite -q -n -o "$mtd" "$image"
	echo "$label: wrote $pages pages"
done

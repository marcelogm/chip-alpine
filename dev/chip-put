#!/bin/sh
set -eu
cd "$(dirname "$0")/.."

local_file=$1
remote_file=$2

if ! ip -4 addr | grep -q 'inet 192\.168\.81\.2/'; then
	echo "give the board's USB network interface 192.168.81.2/24 first (see README)" >&2
	exit 1
fi

dev/chip-sh "rm -f $remote_file; (nc -l -p 9000 > $remote_file &)" 5
sleep 1
python3 -I -c 'import socket, sys
s = socket.create_connection(("192.168.81.1", 9000))
with open(sys.argv[1], "rb") as f:
    s.sendfile(f)
s.close()' "$local_file"

expected=$(sha256sum < "$local_file" | cut -d' ' -f1)
actual=$(dev/chip-sh "while pidof nc > /dev/null; do sleep 1; done; sha256sum < $remote_file" 120 | cut -d' ' -f1)
if [ "$actual" != "$expected" ]; then
	echo "$remote_file on the board does not match $local_file" >&2
	exit 1
fi
